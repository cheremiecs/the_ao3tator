{
  "manifest_version": 3,
  "name": "AO3 Annotator",
  "version": "0.1.0",
  "description": "Privately highlight and annotate fanfiction on Archive of Our Own. Everything stays on your device.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://archiveofourown.org/*"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AO3 Annotator"
  },
  "content_scripts": [
    {
      "matches": ["https://archiveofourown.org/works/*"],
      "js": ["dist/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  }
}
